<Window x:Class="TokenMojo.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Session"
        Width="500" SizeToContent="Height" ResizeMode="CanMinimize" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        TextElement.Foreground="{DynamicResource PrimaryTextBrush}" TextElement.FontSize="13">
    <Window.Resources>
        <ResourceDictionary Source="FormStyles.xaml" />
    </Window.Resources>

    <StackPanel Margin="16">
        <TextBlock Style="{StaticResource Caption}" Text="Prompt" />
        <TextBox x:Name="PromptBox" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" AutomationProperties.Name="Prompt"
                 ToolTip="Enter starts the session. Shift+Enter adds a line."
                 PreviewKeyDown="OnPromptKeyDown" TextChanged="OnPromptChanged" />
        <TextBlock x:Name="HintText" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />

        <TextBlock x:Name="DistroCaption" Style="{StaticResource Caption}" Text="Run in" Margin="0,12,0,4" Visibility="Collapsed" />
        <ComboBox x:Name="DistroBox" Visibility="Collapsed" AutomationProperties.Name="Run in"
                  SelectionChanged="OnDistroChanged" />

        <TextBlock Style="{StaticResource Caption}" Text="Folder" Margin="0,12,0,4" />
        <DockPanel>
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Padding="12,5"
                    AutomationProperties.Name="Browse for a folder" Click="OnBrowse" />
            <ComboBox x:Name="FolderBox" IsEditable="True" AutomationProperties.Name="Folder" />
        </DockPanel>

        <DockPanel Margin="0,12,0,0">
            <CheckBox x:Name="WorktreeCheck" DockPanel.Dock="Left" Content="Worktree" AutomationProperties.Name="Use a worktree"
                      Click="OnWorktreeToggled" />
            <TextBox x:Name="WorktreeBox" Margin="12,0,0,0" AutomationProperties.Name="Worktree name"
                     IsEnabled="False" TextChanged="OnWorktreeNameChanged" />
        </DockPanel>

        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource CriticalBrush}"
                   Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Click="OnCancel" Margin="0,0,8,0" />
            <Button x:Name="StartButton" Content="Start" IsDefault="True" IsEnabled="False" Click="OnStart" />
        </StackPanel>
    </StackPanel>
</Window>
